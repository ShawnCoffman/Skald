<Page x:Class="Skald.App.Pages.SummaryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0B151D" Loaded="Page_Loaded">
 <Page.Resources>
  <DataTemplate x:Key="DetailTemplate"><Grid Padding="0,5" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="#98AEB9" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13"/></Grid></DataTemplate>
 </Page.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Padding="28,22,28,28" Spacing="14" SizeChanged="Layout_SizeChanged">
  <StackPanel Spacing="4"><TextBlock Text="System overview" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Your machine, its configuration, and what needs attention." Foreground="#98AEB9" TextWrapping="Wrap"/></StackPanel>
  <Border Background="#29291F" CornerRadius="10" Padding="18,14">
   <StackPanel Spacing="9">
    <TextBlock x:Name="AttentionHeading" Text="Checking status" FontSize="19" FontWeight="SemiBold" Foreground="#F1D39C"/>
    <TextBlock x:Name="AttentionText" Text="Checking device status, storage, and restart signals…" Foreground="#F0E4CF" TextWrapping="Wrap" FontSize="14"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="Inspect hardware" Click="Hardware_Click"/>
     <Button Content="View reliability" Click="Reliability_Click"/>
    </StackPanel>
   </StackPanel>
  </Border>
  <Grid x:Name="Meters" ColumnSpacing="12" RowSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="CpuTile" Background="#14222B" CornerRadius="10" Padding="16,13"><StackPanel Spacing="4"><TextBlock Text="CPU / TOTAL" Foreground="#89B1AD" FontSize="11"/><TextBlock x:Name="CpuValue" Text="—" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="CpuState" Text="Collecting…" Foreground="#A8B8C0" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
   <Border x:Name="MemoryTile" Grid.Column="1" Background="#14222B" CornerRadius="10" Padding="16,13"><StackPanel Spacing="4"><TextBlock Text="MEMORY / PHYSICAL" Foreground="#A9A0D0" FontSize="11"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="MemoryState" Text="Collecting…" Foreground="#A8B8C0" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
   <Border x:Name="DiskTile" Grid.Column="2" Background="#14222B" CornerRadius="10" Padding="16,13"><StackPanel Spacing="4"><TextBlock Text="DISK / ACTIVE" Foreground="#D9B27C" FontSize="11"/><TextBlock x:Name="DiskValue" Text="—" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="DiskState" Text="Collecting…" Foreground="#A8B8C0" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
   <Border x:Name="NetworkTile" Grid.Column="3" Background="#14222B" CornerRadius="10" Padding="16,13"><StackPanel Spacing="4"><TextBlock Text="NETWORK / RECEIVE" Foreground="#8EBBDC" FontSize="11"/><TextBlock x:Name="NetworkValue" Text="—" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="NetworkState" Text="Collecting…" Foreground="#A8B8C0" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
  </Grid>
  <Grid x:Name="IdentityGrid" ColumnSpacing="12" RowSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#14222B" CornerRadius="10" Padding="18,14"><StackPanel Spacing="8"><TextBlock Text="Machine context" FontSize="18" FontWeight="SemiBold"/><ItemsControl x:Name="MachineDetails" ItemTemplate="{StaticResource DetailTemplate}"/><TextBlock x:Name="LiveContext" Text="Collecting machine identity…" Foreground="#9ED8CA" TextWrapping="Wrap" FontSize="12"/></StackPanel></Border>
   <Border x:Name="OsPanel" Grid.Column="1" Background="#14222B" CornerRadius="10" Padding="18,14"><StackPanel Spacing="8"><TextBlock Text="OS &amp; firmware" FontSize="18" FontWeight="SemiBold"/><ItemsControl x:Name="OsDetails" ItemTemplate="{StaticResource DetailTemplate}"/></StackPanel></Border>
  </Grid>
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="Inventory details" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="InventoryStatus" Text="Loading inventory in the background…" Foreground="#B7C9D0" FontSize="12" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click"/><Button x:Name="CopyButton" Content="Copy system summary" Click="Copy_Click" IsEnabled="False"/></StackPanel></Grid>
  <Grid x:Name="HealthGrid" ColumnSpacing="12" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#14222B" CornerRadius="10" Padding="18,14"><StackPanel Spacing="8"><TextBlock Text="Reliability · last 7 days" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReliabilitySummaryText" Text="Checking reports…" TextWrapping="Wrap"/><TextBlock x:Name="LatestProblemText" Foreground="#D9B27C" TextWrapping="Wrap" FontSize="12"/><Button Content="View reliability &amp; dumps" HorizontalAlignment="Left" Click="Reliability_Click"/></StackPanel></Border>
   <Border x:Name="UpdatePanel" Grid.Column="1" Background="#14222B" CornerRadius="10" Padding="18,14"><StackPanel Spacing="8"><TextBlock Text="Windows updates" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="UpdateSummaryText" Text="Checking update history…" TextWrapping="Wrap"/><TextBlock x:Name="HealthStatusText" Foreground="#98AEB9" TextWrapping="Wrap" FontSize="12"/><Button Content="View update history" HorizontalAlignment="Left" Click="Updates_Click"/></StackPanel></Border>
  </Grid>
  <Expander x:Name="DevicesExpander" Header="Devices reporting problems · Checking…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8"><TextBlock Text="Present Plug and Play devices with a nonzero Device Manager status code. Disabled devices are listed separately from other problems." TextWrapping="Wrap" Foreground="#98AEB9" FontSize="12"/><ScrollViewer MaxHeight="220"><TextBlock x:Name="DeviceDetails" Text="Checking…" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer></StackPanel></Expander>
  <Expander x:Name="StorageExpander" Header="Storage capacity · Checking…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock x:Name="StorageDetails" Text="Checking…" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
  <Expander x:Name="AppsExpander" Header="Installed apps · Checking…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8"><TextBlock Text="Desktop registrations for this machine and user, plus this user's packaged apps. Frameworks and system components are excluded; the count can include separate registrations of the same app. Other user profiles are not included." TextWrapping="Wrap" Foreground="#98AEB9" FontSize="12"/><TextBox x:Name="AppSearch" PlaceholderText="Filter apps by name or publisher" TextChanged="AppSearch_TextChanged"/><ScrollViewer MaxHeight="250"><TextBlock x:Name="AppDetails" Text="Checking…" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer></StackPanel></Expander>
  <TextBlock x:Name="LimitationsText" Foreground="#D9B27C" FontSize="12" TextWrapping="Wrap"/>
 </StackPanel>
 </ScrollViewer>
</Page>
