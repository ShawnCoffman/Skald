<Page x:Class="Skald.App.Pages.CpuPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Skald.App.Controls" Background="#0B151D">
 <ScrollViewer><StackPanel Padding="24,18,24,24" Spacing="14">
 <TextBlock Text="CPU" FontSize="26" FontWeight="SemiBold" />
 <TextBlock x:Name="StatusText" Foreground="#AABFC8" />
 <local:HistoryChart x:Name="CpuChart" MetricName="CPU utilization" Unit="%" Height="190" />
 <TextBlock x:Name="PressureText" Text="Queue and interrupt counters collecting…" Foreground="#AABFC8" TextWrapping="Wrap" />
 <TextBlock Text="Top CPU processes" FontSize="18" />
 <TextBlock x:Name="TopProcessesText" Text="Collecting…" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
 <Button Content="Open Processes" HorizontalAlignment="Left" Click="Processes_Click"/>
 <TextBlock Text="Logical processors · group,index · 0–100%" FontSize="18" />
 <TextBlock Text="Windows reported clocks may be nominal; effective clock is not collected." Foreground="#AABFC8" TextWrapping="Wrap" />
 <ItemsControl x:Name="CoreList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="160" ItemHeight="100" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#14222B" CornerRadius="7" Padding="12" Margin="0,0,8,8"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" Foreground="#AABFC8" /><TextBlock Text="{Binding Usage}" FontSize="20" /><TextBlock Text="{Binding Clock}" Foreground="#AABFC8" FontSize="12" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></ScrollViewer>
</Page>
