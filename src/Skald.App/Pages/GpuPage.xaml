<Page
    x:Class="Skald.App.Pages.GpuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Skald.App.Controls"
    Background="#0B151D">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,18,28,28" Spacing="18">
            <StackPanel Spacing="3">
                <TextBlock Text="GPU" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Driver sensors and Windows video-memory accounting, shown separately when device matching is unavailable." Foreground="#98AEB9" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8"><TextBlock Text="GPU ENGINE UTILIZATION" Foreground="#82C9E8" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="EngineStatus" Text="Waiting for engine counters…" Foreground="#9FB3BC" TextWrapping="Wrap"/><local:HistoryChart x:Name="EngineChart" MetricName="Busiest GPU engine" Unit="%" Height="180"/><TextBlock x:Name="EngineDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Text="Top processes by busiest engine" FontSize="17"/><TextBlock x:Name="TopProcessesText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><Button Content="Open Processes" HorizontalAlignment="Left" Click="Processes_Click"/></StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="DEVICE SENSORS" Foreground="#82C9E8" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="SensorStatus" Text="Waiting for telemetry…" Foreground="#9FB3BC" />
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#142B35" CornerRadius="10" Padding="18" Margin="0,0,0,8">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Source}" Foreground="#94AEB9" FontSize="12" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4"><TextBlock Text="GPU TEMPERATURE" Foreground="#94AEB9" FontSize="11" /><TextBlock Text="{Binding Temperature}" FontSize="25" FontWeight="SemiBold" /></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="GPU POWER" Foreground="#94AEB9" FontSize="11" /><TextBlock Text="{Binding Power}" FontSize="25" FontWeight="SemiBold" /></StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="DEDICATED MEMORY" Foreground="#94AEB9" FontSize="11" /><TextBlock Text="{Binding Memory}" FontSize="25" FontWeight="SemiBold" /></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="WINDOWS GPU MEMORY" Foreground="#B6A7E2" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="MemoryStatus" Text="Waiting for telemetry…" Foreground="#9FB3BC" />
                <ItemsControl x:Name="AdapterList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1D2534" CornerRadius="10" Padding="16" Margin="0,0,0,8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding Key}" Foreground="#899DA9" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="DEDICATED IN USE" Foreground="#94AEB9" FontSize="11" /><TextBlock Text="{Binding Dedicated}" FontSize="20" /></StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="SHARED IN USE" Foreground="#94AEB9" FontSize="11" /><TextBlock Text="{Binding Shared}" FontSize="20" /></StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="Per-process GPU memory is in Processes. Process totals can double-count allocations shared with other processes; adapter usage is the better system-wide view. Temperature and power require a supported vendor sensor." Foreground="#8297A2" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
