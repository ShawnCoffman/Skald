<Page x:Class="Skald.App.Pages.ReliabilityPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0B151D" Loaded="Page_Loaded">
 <ScrollViewer><StackPanel Padding="28,22,28,28" Spacing="14">
  <TextBlock Text="Reliability &amp; events" FontSize="27" FontWeight="SemiBold"/>
  <TextBlock Text="What failed, when it started, and the reports around it." Foreground="#98AEB9"/>
  <StackPanel Orientation="Horizontal" Spacing="10">
   <ComboBox x:Name="RangePicker" SelectedIndex="1" SelectionChanged="Filter_Changed" AutomationProperties.Name="Time range"><ComboBoxItem Content="24 hours"/><ComboBoxItem Content="7 days"/><ComboBoxItem Content="30 days"/></ComboBox>
   <ComboBox x:Name="CategoryPicker" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Event category"><ComboBoxItem Content="Problems"/><ComboBoxItem Content="All categories"/><ComboBoxItem Content="Applications"/><ComboBoxItem Content="Windows reports"/><ComboBoxItem Content="Crashes &amp; restarts"/><ComboBoxItem Content="Hardware"/><ComboBoxItem Content="Firmware &amp; diagnostics"/><ComboBoxItem Content="Drivers &amp; storage"/><ComboBoxItem Content="Changes"/></ComboBox>
   <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click"/>
   <Button Content="Clear day filter" Click="ClearDay_Click"/>
  </StackPanel>
  <TextBlock x:Name="StatusText" Text="Loading Windows history…" Foreground="#9ED8CA" TextWrapping="Wrap"/>
  <Expander x:Name="DumpExpander" Header="Crash dumps · Checking…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8"><TextBlock Text="Existing dump files are evidence, not a count of crashes. Scans system locations and the current user's app dump folder." Foreground="#98AEB9" TextWrapping="Wrap" FontSize="12"/><Button Content="Include other profiles" HorizontalAlignment="Left" Click="OtherProfiles_Click"/><ScrollViewer MaxHeight="180"><TextBlock x:Name="DumpDetails" Text="Checking…" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer></StackPanel></Expander>
  <Border Background="#14222B" CornerRadius="10" Padding="16"><StackPanel Spacing="8"><TextBlock Text="Reports by day" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Bar height shows the relative number of reports in the selected time range. It does not show severity or unique incidents. Select a day to filter." Foreground="#B7C9D0" FontSize="12" TextWrapping="Wrap"/><ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Timeline" Orientation="Horizontal" Spacing="6"/></ScrollViewer></StackPanel></Border>
  <TextBox x:Name="SearchBox" PlaceholderText="Search application, device, source, event ID, or message" TextChanged="Search_Changed"/>
  <ToggleSwitch x:Name="GroupToggle" Header="Group recurring reports by source, event ID, and component" OnContent="Grouped" OffContent="Individual reports" IsOn="True" Toggled="Group_Toggled"/>
  <Grid x:Name="ResultsGrid" ColumnSpacing="14" RowSpacing="14" SizeChanged="Results_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="8"><TextBlock x:Name="ResultCount" Text="Reports" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="EmptyText" Text="Gathering records…" Foreground="#98AEB9" TextWrapping="Wrap"/><ListView x:Name="ReportsList" Height="400" SelectionChanged="Report_Selected" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="4,8" Spacing="4"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" FontSize="12" Foreground="#98AEB9"/><TextBlock Text="{Binding Dates}" FontSize="12" Foreground="#9ED8CA" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
   <Border x:Name="DetailPanel" Grid.Column="1" Background="#14222B" CornerRadius="10" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Report details" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="DetailHeading" Text="Select a report to inspect its evidence." TextWrapping="Wrap"/><TextBlock x:Name="InterpretationText" TextWrapping="Wrap" Foreground="#D9B27C" FontSize="12"/><TextBlock x:Name="TriageText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/><Button x:Name="CopyDumpCommandButton" Content="Copy WinDbg command" Click="CopyDumpCommand_Click" IsEnabled="False" HorizontalAlignment="Left"/><ScrollViewer MaxHeight="230"><TextBlock x:Name="DetailText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/></ScrollViewer><Expander Header="Occurrences" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ScrollViewer MaxHeight="160"><TextBlock x:Name="OccurrenceText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/></ScrollViewer></Expander><Expander Header="Raw details of selected / latest report" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ScrollViewer MaxHeight="240"><TextBlock x:Name="RawText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="11"/></ScrollViewer></Expander></StackPanel></Border>
  </Grid>
  <Expander Header="Sources and coverage" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8"><TextBlock x:Name="SourcesText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/><TextBlock Text="History depends on retained Windows logs and the reliability provider. Corrected hardware errors may be warnings. Installation/update reports are context, not necessarily failures. Grouping does not establish a common root cause. No historical performance measurements are inferred from these events." TextWrapping="Wrap" Foreground="#98AEB9" FontSize="12"/></StackPanel></Expander>
 </StackPanel></ScrollViewer>
</Page>


