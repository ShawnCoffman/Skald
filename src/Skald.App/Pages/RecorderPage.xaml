<Page
    x:Class="Skald.App.Pages.RecorderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,10,28,28"><StackPanel Spacing="18"><StackPanel><TextBlock Text="Flight Recorder" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Capture the slow moment, then replay it after the problem is gone." Foreground="#A5A7B0" /></StackPanel><Border Background="#20252A" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="How it works" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Skald keeps a five-minute rolling buffer even before you press Record. Start a session when investigating a problem, press Mark Problem when it happens, and stop when you have enough context." TextWrapping="Wrap" Foreground="#C8CBD2" Margin="0,8,0,0" /></StackPanel></Border><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#1B1D22" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="Standard" Foreground="#A5A7B0" /><TextBlock Text="2 sec samples" FontSize="22" Margin="0,6,0,0" /><TextBlock Text="CPU, memory, disks, processes" Foreground="#A5A7B0" /></StackPanel></Border><Border Grid.Column="1" Background="#1B1D22" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="Portable" Foreground="#A5A7B0" /><TextBlock Text=".perfsession" FontSize="22" Margin="0,6,0,0" /><TextBlock Text="Compressed, local, replayable" Foreground="#A5A7B0" /></StackPanel></Border><Border Grid.Column="2" Background="#1B1D22" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="Privacy" Foreground="#A5A7B0" /><TextBlock Text="Read-only" FontSize="22" Margin="0,6,0,0" /><TextBlock Text="No usage telemetry" Foreground="#A5A7B0" /></StackPanel></Border></Grid></StackPanel></ScrollViewer>
</Page>
