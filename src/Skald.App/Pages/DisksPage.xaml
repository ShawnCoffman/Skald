<Page x:Class="Skald.App.Pages.DisksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Skald.App.Controls" Background="#0B151D" Loaded="Page_Loaded">
 <ScrollViewer><StackPanel Padding="28,18,28,28" Spacing="14">
  <TextBlock Text="Disks" FontSize="26" FontWeight="SemiBold"/>
  <TextBlock Text="Physical disk activity and latency. Volume capacity is listed separately." Foreground="#A5A7B0" TextWrapping="Wrap"/>
  <TextBlock x:Name="ActivityText" Text="Collecting…" FontSize="24"/>
  <TextBlock x:Name="DetailText" Foreground="#A5A7B0" TextWrapping="Wrap"/>
  <TextBlock Text="Aggregate transfers · last 3 minutes" FontSize="18"/><local:HistoryChart x:Name="TransfersChart" MetricName="Aggregate transfers" Unit="transfers/s" Height="175"/>
  <TextBlock Text="Selected disk throughput · last 3 minutes" FontSize="18"/><ComboBox x:Name="DiskPicker" DisplayMemberPath="Name" SelectionChanged="Disk_Changed" MinWidth="220"/><local:HistoryChart x:Name="DiskChart" MetricName="Read + write throughput" Unit="B/s" Height="160"/><TextBlock x:Name="DiskScaleText" Foreground="#AABFC8"/>
  <TextBlock Text="Physical disks" FontSize="18"/><ItemsControl x:Name="DiskList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#14222B" CornerRadius="8" Padding="15" Margin="0,0,0,8"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Activity}" TextWrapping="Wrap"/><TextBlock Text="{Binding Throughput}" Foreground="#AABFC8" TextWrapping="Wrap"/><TextBlock Text="{Binding Latency}" Foreground="#AABFC8" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="Top processes by I/O" FontSize="18"/><TextBlock x:Name="TopProcessesText" TextWrapping="Wrap" Foreground="#AABFC8"/><TextBlock Text="Process I/O includes cached and non-disk operations; it is not attribution to a physical disk." Foreground="#8297A2" FontSize="12" TextWrapping="Wrap"/>
  <Button Content="Open Processes" HorizontalAlignment="Left" Click="Processes_Click"/>
  <TextBlock Text="Fixed-volume capacity" FontSize="18"/><TextBlock x:Name="CapacityText" Text="Checking…" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="#AABFC8"/>
  <TextBlock Text="Storage device reliability" FontSize="18"/><TextBlock x:Name="StorageHealthText" Text="Checking…" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="#AABFC8"/>
  <TextBlock Text="Latency is a sampled average per completed read or write. A busy disk alone does not establish a storage bottleneck." Foreground="#8297A2" TextWrapping="Wrap" FontSize="12"/>
 </StackPanel></ScrollViewer>
</Page>
