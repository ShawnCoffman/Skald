<Page
    x:Class="Skald.App.Pages.SystemInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28,10,28,28"><StackPanel Spacing="18"><StackPanel><TextBlock Text="System Info" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Capabilities are discovered instead of assumed." Foreground="#A5A7B0" /></StackPanel><Border Background="#1B1D22" CornerRadius="8" Padding="18"><StackPanel Spacing="8"><TextBlock x:Name="MachineText" Text="Machine: —" FontSize="18" /><TextBlock x:Name="OsText" Text="Operating system: —" Foreground="#C8CBD2" /><TextBlock x:Name="CpuText" Text="Logical processors: —" Foreground="#C8CBD2" /><TextBlock x:Name="MemoryText" Text="Physical memory: —" Foreground="#C8CBD2" /></StackPanel></Border><Border Background="#1B1D22" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="Telemetry capabilities" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" /><TextBlock Text="CPU utilization                         Supported" Foreground="#C8CBD2" /><TextBlock Text="Physical memory                         Supported" Foreground="#C8CBD2" Margin="0,6,0,0" /><TextBlock Text="Physical disk activity                  Capability-dependent" Foreground="#C8CBD2" Margin="0,6,0,0" /><TextBlock Text="Battery / package power                Coming next" Foreground="#C8CBD2" Margin="0,6,0,0" /></StackPanel></Border></StackPanel></ScrollViewer>
</Page>
