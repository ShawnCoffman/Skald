<UserControl
    x:Class="Skald.App.Controls.HistoryChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Chart_SizeChanged">
    <Grid Background="#101E27" Padding="8,6,10,6" RowSpacing="4">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="AxisTitleText" Text="Y · Value" FontSize="12" Foreground="#B7C9D0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="MaxObservedText" Grid.Column="1" Text="Max observed —" FontSize="12" Foreground="#D6E7E8" FontWeight="SemiBold"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
                <TextBlock x:Name="MaxTickText" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="11" Foreground="#9FB8C1"/>
                <TextBlock x:Name="MidTickText" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Foreground="#9FB8C1"/>
                <TextBlock x:Name="ZeroTickText" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="11" Foreground="#9FB8C1"/>
            </Grid>
            <Canvas x:Name="Plot" Grid.Column="1" />
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="X · Time" FontSize="11" Foreground="#B7C9D0"/>
            <Grid Grid.Column="1"><TextBlock x:Name="StartTimeText" FontSize="11" Foreground="#9FB8C1"/><TextBlock x:Name="EndTimeText" HorizontalAlignment="Right" FontSize="11" Foreground="#9FB8C1"/></Grid>
        </Grid>
    </Grid>
</UserControl>
